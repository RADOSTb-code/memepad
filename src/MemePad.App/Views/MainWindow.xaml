<Window x:Class="MemePad.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MemePad.App.Localization"
        xmlns:vm="clr-namespace:MemePad.App.ViewModels"
        Title="MemePad" Width="1040" Height="680" MinWidth="720" MinHeight="420"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Page tabs: a horizontal list whose selected item gets the line-colored pill -->
        <Style x:Key="PageTab" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Height="32" Padding="12,0" CornerRadius="8" Background="Transparent" Margin="0,0,4,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Line}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sound rows: 52 px, rounded hover/playing surface, no default selection blue -->
        <Style x:Key="SoundRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Height="52" Padding="12,0" CornerRadius="10" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SoundRowTemplate" DataType="{x:Type vm:SoundRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="32" Height="32" Margin="0,0,14,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" ToolTip="{x:Static loc:L.Play}"
                        AutomationProperties.Name="{Binding Title}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Circle" Fill="{StaticResource Chip}" />
                                <Path x:Name="Glyph" Data="{StaticResource IconPlay}" Fill="{StaticResource Text}" Width="11" Height="11"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource IconStop}" />
                                    <Setter TargetName="Glyph" Property="Fill" Value="{StaticResource AccentText}" />
                                    <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" x:Name="StateText" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource Warn}" Visibility="Collapsed" />

                <Path Grid.Column="3" Data="{StaticResource IconStar}" Fill="{StaticResource Star}" Width="14" Height="14"
                      Stretch="Uniform" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="{x:Static loc:L.Favorite}"
                      Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" />

                <Border Grid.Column="5" x:Name="Chip" Style="{StaticResource KeyChip}" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HotkeyText}" HorizontalAlignment="Center" Foreground="#C9CCD4"
                               FontFamily="{StaticResource MonoFont}" FontSize="12" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HotkeyText}" Value="">
                    <Setter TargetName="Chip" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Missing">
                    <Setter TargetName="StateText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StateText" Property="Text" Value="{x:Static loc:L.FileMissing}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unreadable">
                    <Setter TargetName="StateText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StateText" Property="Text" Value="{x:Static loc:L.FileUnreadable}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="MemePad" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />

                <ListBox DockPanel.Dock="Left" Margin="24,0,0,0" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         ItemContainerStyle="{StaticResource PageTab}" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{x:Static loc:L.DefaultPage}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static loc:L.RenamePage}" Command="{Binding RenamePageCommand}" />
                            <MenuItem Header="{x:Static loc:L.DeletePage}" Command="{Binding DeletePageCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="{Binding AddPageCommand}"
                        ToolTip="{x:Static loc:L.AddPage}" AutomationProperties.Name="{x:Static loc:L.AddPage}">
                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource StrokeIcon}" Width="14" Height="14" />
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}"
                        ToolTip="{x:Static loc:L.Settings}" AutomationProperties.Name="{x:Static loc:L.Settings}">
                    <Path Data="{StaticResource IconSliders}" Style="{StaticResource StrokeIcon}" StrokeThickness="1.8" />
                </Button>

                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0" IsChecked="{Binding ShowFavoritesOnly}"
                              ToolTip="{x:Static loc:L.FavoritesOnly}" AutomationProperties.Name="{x:Static loc:L.FavoritesOnly}">
                    <Path x:Name="FavIcon" Data="{StaticResource IconStar}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{StaticResource Muted}" StrokeThickness="1.6">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Star}" />
                                        <Setter Property="Stroke" Value="{StaticResource Star}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>

                <Grid DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource FieldBox}" Tag="{x:Static loc:L.Search}" Padding="30,0,10,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static loc:L.Search}" />
                    <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource Muted}" StrokeThickness="2" Width="13" Height="13"
                          Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Text to speech: one line under the header -->
        <Grid Grid.Row="1" Margin="24,12,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource FieldBox}" Tag="{x:Static loc:L.SpeakPlaceholder}" KeyDown="OnSpeechKeyDown"
                     Text="{Binding SpeechText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static loc:L.SpeakPlaceholder}" />
            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Content="{x:Static loc:L.Speak}" Command="{Binding SpeakCommand}" />
            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Margin="4,0,0,0" Content="{x:Static loc:L.ToLibrary}" Command="{Binding SaveSpeechCommand}" />
        </Grid>

        <!-- Sound list, with the cable onboarding and the one-time Discord tip above it -->
        <DockPanel Grid.Row="2" Margin="12,4,12,8">
            <Border DockPanel.Dock="Top" Margin="12,8,12,8" Padding="18,16" CornerRadius="12" Background="{StaticResource Surface}"
                    Visibility="{Binding IsCableMissing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:L.CableTitle}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static loc:L.CableBody}" Foreground="#C9CCD4" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Static loc:L.CablePreviewNote}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource OutlineButton}" Content="{x:Static loc:L.CableDownload}" Command="{Binding DownloadCableCommand}" />
                        <Button Style="{StaticResource FlatButton}" Content="{x:Static loc:L.CableRetry}" Command="{Binding RetryCableCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Margin="12,8,12,8" Padding="18,14" CornerRadius="12" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    Visibility="{Binding ShowDiscordTip, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="{x:Static loc:L.Got}" Command="{Binding DismissTipCommand}"
                            VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:L.DiscordTipTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static loc:L.DiscordTip}" Foreground="#C9CCD4" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

        <Grid>
            <ListBox x:Name="SoundList" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SoundRowTemplate}"
                     ItemContainerStyle="{StaticResource SoundRow}" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="OnRowDoubleClick" KeyDown="OnListKeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static loc:L.Play}" Command="{Binding PlayCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{x:Static loc:L.AssignHotkey}" Command="{Binding AssignHotkeyCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{x:Static loc:L.Edit}" Command="{Binding EditSoundCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{x:Static loc:L.ToggleFavorite}" Command="{Binding ToggleFavoriteCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{x:Static loc:L.Remove}" Command="{Binding RemoveCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <TextBlock Text="{x:Static loc:L.DropHint}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        </DockPanel>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource Footer}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="200">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineStatus}" Value="Running">
                                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStatus}" Value="Reconnecting">
                                        <Setter Property="Fill" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineStatus}" Value="NoCable">
                                        <Setter Property="Fill" Value="{StaticResource Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Foreground="#C9CCD4" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="{x:Static loc:L.Mic}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Width="120" Style="{StaticResource ThinSlider}" Value="{Binding MicVolume}"
                            AutomationProperties.Name="{x:Static loc:L.Mic}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="{x:Static loc:L.Sounds}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Width="120" Style="{StaticResource ThinSlider}" Value="{Binding SoundsVolume}"
                            AutomationProperties.Name="{x:Static loc:L.Sounds}" VerticalAlignment="Center" />
                </StackPanel>

                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding StopAllCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static loc:L.Stop}" />
                        <TextBlock Text="{Binding StopHotkeyText}" Margin="6,0,0,0" Foreground="{StaticResource Muted}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="MemePad.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MemePad.App.Localization"
        xmlns:vm="clr-namespace:MemePad.App.ViewModels"
        Style="{StaticResource DialogWindow}" Title="{x:Static loc:L.Settings}" Width="560" Height="680" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyRow" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{x:Static loc:L.RunAsAdmin}" Click="OnRunAsAdmin"
                        ToolTip="{x:Static loc:L.RunAsAdminHint}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="{x:Static loc:L.Save}" IsDefault="True" Click="OnSave" />
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static loc:L.Cancel}" IsCancel="True" Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,2,24,20">
                <!-- Devices -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:L.SecDevices}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static loc:L.Microphone}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMic}" AutomationProperties.Name="{x:Static loc:L.Microphone}" />
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="{x:Static loc:L.HearMyself}" IsChecked="{Binding MonitorEnabled}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static loc:L.MonitorDevice}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedMonitor}"
                              IsEnabled="{Binding MonitorEnabled}" AutomationProperties.Name="{x:Static loc:L.MonitorDevice}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static loc:L.MonitorVolume}" />
                    <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource ThinSlider}" Value="{Binding MonitorVolume}" VerticalAlignment="Center"
                            IsEnabled="{Binding MonitorEnabled}" AutomationProperties.Name="{x:Static loc:L.MonitorVolume}" />
                </Grid>

                <!-- Hotkeys -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:L.SecHotkeys}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Label}" Text="{x:Static loc:L.KeyStop}" />
                    <Button Grid.Column="1" Style="{StaticResource KeyRow}" Command="{Binding CaptureCommand}" CommandParameter="{x:Static vm:HotkeySlot.Stop}">
                        <Border Style="{StaticResource KeyChip}"><TextBlock Text="{Binding StopText}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    </Button>

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static loc:L.KeyNextPage}" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyRow}" Command="{Binding CaptureCommand}" CommandParameter="{x:Static vm:HotkeySlot.NextPage}">
                        <Border Style="{StaticResource KeyChip}"><TextBlock Text="{Binding NextPageText}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    </Button>

                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{x:Static loc:L.KeyPrevPage}" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyRow}" Command="{Binding CaptureCommand}" CommandParameter="{x:Static vm:HotkeySlot.PrevPage}">
                        <Border Style="{StaticResource KeyChip}"><TextBlock Text="{Binding PrevPageText}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    </Button>

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static loc:L.KeyRecord}" />
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyRow}" Command="{Binding CaptureCommand}" CommandParameter="{x:Static vm:HotkeySlot.Record}">
                        <Border Style="{StaticResource KeyChip}"><TextBlock Text="{Binding RecordText}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    </Button>

                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static loc:L.HistoryLength}" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Width="140" Style="{StaticResource ThinSlider}" Minimum="10" Maximum="120" Value="{Binding HistorySeconds}"
                                IsSnapToTickEnabled="True" TickFrequency="5" AutomationProperties.Name="{x:Static loc:L.HistoryLength}" />
                        <TextBlock Text="{Binding HistorySeconds}" Width="36" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{x:Static loc:L.KeyEffect}" />
                    <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource KeyRow}" Command="{Binding CaptureCommand}" CommandParameter="{x:Static vm:HotkeySlot.EffectToggle}">
                        <Border Style="{StaticResource KeyChip}"><TextBlock Text="{Binding EffectToggleText}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    </Button>

                    <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="{x:Static loc:L.Swallow}" IsChecked="{Binding SwallowHotkeys}" />
                </Grid>

                <!-- Push-to-talk and playback -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:L.SecPlayback}" />
                <CheckBox Content="{x:Static loc:L.PttEnable}" IsChecked="{Binding PttEnabled}" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static loc:L.PttKey}" />
                    <Button Grid.Column="1" Style="{StaticResource KeyRow}" Command="{Binding CaptureCommand}" CommandParameter="{x:Static vm:HotkeySlot.PushToTalk}"
                            IsEnabled="{Binding PttEnabled}">
                        <Border Style="{StaticResource KeyChip}"><TextBlock Text="{Binding PttKeyText}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Center" /></Border>
                    </Button>
                </Grid>
                <ComboBox ItemsSource="{Binding Modes}" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />

                <!-- Voice effect -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:L.SecVoice}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static loc:L.Effect}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Effects}" SelectedValuePath="Value" SelectedValue="{Binding Effect}" />
                </Grid>
                <CheckBox Content="{x:Static loc:L.EffectOn}" IsChecked="{Binding EffectEnabled}" Margin="0,12,0,0" />

                <!-- Text to speech -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:L.SecTts}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static loc:L.TtsVoice}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Voices}" SelectedValuePath="Value" SelectedValue="{Binding TtsVoice}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static loc:L.TtsRate}" />
                    <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="-5" Maximum="5" IsSnapToTickEnabled="True"
                            TickFrequency="1" Value="{Binding TtsRate}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static loc:L.TtsRate}" />
                </Grid>

                <!-- General -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static loc:L.SecGeneral}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static loc:L.Language}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedValuePath="Value" SelectedValue="{Binding Language}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

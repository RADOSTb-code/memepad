<Window x:Class="MemePad.App.Views.SoundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MemePad.App.Localization"
        Style="{StaticResource DialogWindow}" Title="{x:Static loc:L.EditTitle}" Width="640" SizeToContent="Height">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

        <!-- Waveform; the shaded parts are cut off by the trim -->
        <Border Margin="0,16,0,0" Height="120" CornerRadius="10" Background="{StaticResource Surface}" ClipToBounds="True">
            <Grid x:Name="WaveHost" SizeChanged="OnWaveSizeChanged">
                <Polygon x:Name="Wave" Fill="{StaticResource Accent}" Opacity="0.85" />
                <Rectangle x:Name="CutLeft" Fill="{StaticResource Bg}" Opacity="0.75" HorizontalAlignment="Left" />
                <Rectangle x:Name="CutRight" Fill="{StaticResource Bg}" Opacity="0.75" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static loc:L.TrimStart}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Maximum="{Binding DurationSeconds}" VerticalAlignment="Center"
                    Value="{Binding TrimStartSeconds}" AutomationProperties.Name="{x:Static loc:L.TrimStart}" />
            <TextBlock Grid.Column="2" Text="{Binding TrimStartSeconds, StringFormat={}{0:0.00} s}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" />

            <TextBlock Grid.Row="1" Text="{x:Static loc:L.TrimEnd}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource ThinSlider}" Maximum="{Binding DurationSeconds}" VerticalAlignment="Center"
                    Value="{Binding TrimEndSeconds}" AutomationProperties.Name="{x:Static loc:L.TrimEnd}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TrimEndSeconds, StringFormat={}{0:0.00} s}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" />

            <TextBlock Grid.Row="2" Text="{x:Static loc:L.Volume}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="-24" Maximum="12" VerticalAlignment="Center"
                    Value="{Binding GainDb}" AutomationProperties.Name="{x:Static loc:L.Volume}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0} dB}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" />
        </Grid>

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{x:Static loc:L.Preview}" Command="{Binding PreviewCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="{x:Static loc:L.Save}" IsDefault="True" Click="OnSave" />
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static loc:L.Cancel}" IsCancel="True" Margin="0,0,8,0" />
        </DockPanel>
    </StackPanel>
</Window>

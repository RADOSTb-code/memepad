<Window x:Class="MemePad.App.Views.HotkeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MemePad.App.Localization"
        Style="{StaticResource DialogWindow}" Width="420" SizeToContent="Height"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown">
    <StackPanel Margin="24">
        <TextBlock Text="{x:Static loc:L.HotkeyPrompt}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />

        <Border Style="{StaticResource KeyChip}" HorizontalAlignment="Center" Margin="0,20" Padding="20,10" MinWidth="160">
            <TextBlock x:Name="KeyText" Text="…" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="18" />
        </Border>

        <StackPanel x:Name="ConflictPanel" Visibility="Collapsed">
            <TextBlock x:Name="ConflictText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource FlatButton}" Content="{x:Static loc:L.Cancel}" Click="OnConflictCancel" Margin="0,0,8,0" />
                <Button Style="{StaticResource OutlineButton}" Content="{x:Static loc:L.Reassign}" Click="OnConflictAccept" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="HelpText" Text="{x:Static loc:L.HotkeyHelp}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
